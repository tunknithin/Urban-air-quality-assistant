# GEMINI_API_KEY: Optional server-side API key for Gemini AI assistant responses.
# Keep empty or inject via your host Secrets manager; never expose to browser code.
GEMINI_API_KEY=

# APP_URL: Public base URL where the application is hosted.
APP_URL=

# PORT: HTTP port for the Express + Vite server (default: 3000).
PORT=3000

# TRUST_PROXY: Express trust proxy hop count (default: 1 for Cloud Run/reverse proxy; set 0 or false if direct).
TRUST_PROXY=1

# DB_PATH: Optional path to persistent SQLite database file (default: ./data/uaqa.db).
DB_PATH=./data/uaqa.db
